# macOS and editor temporary files
.DS_Store
._*
*~
*.swp
*.swo

# Local credentials (keep example templates)
.env
.env.*
!.env.example
!.env.*.example

# Python bytecode, caches, and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
